# === Basis ===================================================================
# Öffentliche URL der App (lokal http://localhost:3000, in Prod deine Domain).
APP_URL=http://localhost:3000
# Umgebung: development | staging | production (nur zur Kennzeichnung).
# Alle Umgebungen nutzen dieselben Live-Produkte auf Digistore24 (siehe
# docs/environments.md). Lokal IPNs empfangen: scripts/dev/tunnel.sh (Cloudflare).
APP_ENV=development

# === Datenbank (Postgres) ====================================================
# Lokal via docker-compose (siehe docker-compose.yml). In Prod: managed Postgres
# (Railway/Render/Fly bieten das per Klick).
DATABASE_URL=postgresql://app:app@localhost:5432/app
# Port, auf dem die lokale Docker-Postgres erreichbar ist. Nur ändern, wenn 5432
# schon belegt ist (anderes Projekt/lokale Postgres) — dann auch den Port in
# DATABASE_URL oben anpassen.
# DB_PORT=5432
# Größe des DB-Verbindungspools pro Prozess (Default 10). Auf einem einzelnen
# Server ruhig 10–20; bei serverless niedrig halten + Connection-Pooler nutzen.
# DB_POOL_MAX=10

# === Auth.js =================================================================
# Zufälliges Geheimnis:  openssl rand -hex 32
AUTH_SECRET=
# Hinter Proxy/PaaS nötig, damit der dynamische Host akzeptiert wird.
AUTH_TRUST_HOST=true

# Optionaler Produktname (erscheint im Betreff/Text der Login-Mail).
# APP_NAME=Meine App

# --- Entwicklungs-Login (nur DEV) ---
# Solange KEIN Mailversand konfiguriert ist und APP_ENV=development gilt (und
# APP_URL auf localhost zeigt), kannst du dich ohne Magic-Link und ohne
# Passwort anmelden — damit du die App sofort ausprobieren kannst.
# Sobald Postmark oder SMTP eingerichtet ist, verschwindet er automatisch.
# In STAGING/PROD gibt es ihn nie; dort ist der Mailversand Pflicht und die App
# startet ohne ihn gar nicht erst. Einrichten: make mail-setup
# Hart abschalten:
# DEV_LOGIN=off

# --- Login (Standard): E-Mail-Token / Magic-Link ---
# Genau EINEN E-Mail-Transport konfigurieren — Postmark ODER SMTP.
# Absenderadresse (Fallback, falls unten keine transport-spezifische gesetzt ist).
EMAIL_FROM=login@deine-domain.de
#
# Variante A: Postmark (Server-Token + verifizierter Absender/Sender-Signatur)
# POSTMARK_SERVER_TOKEN=
# POSTMARK_SENDER=login@deine-domain.de
# POSTMARK_MESSAGE_STREAM=outbound
#
# Variante B: SMTP (beliebiger Mailserver / Mailbox)
# SMTP_HOST=smtp.deinprovider.de
# SMTP_PORT=587
# SMTP_SECURE=false           # true = Port 465 (SSL), false = 587 (STARTTLS)
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=login@deine-domain.de

# --- Login (optional): Google OAuth ---
# Einrichtung + Freigabe dauern (Google prüft die App). Anleitung: docs/auth-setup.md
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# === Digistore24 =============================================================
# API-Basis von Digistore24 (in der Regel unverändert lassen)
DIGISTORE_URL=https://www.digistore24.com

# API-Key und IPN-Passphrase gehören hier herein — die App liest sie aus der
# Umgebung (lib/digistore/settings.ts). Es gibt bewusst KEINE Oberfläche, um sie
# einzutragen: der Schlüssel gehört der Installation, nicht einem Benutzer.
#
# Beide Werte schreibt der Verbindungsassistent selbst hierher:
#
#   make ds24-connect
#
# Der öffnet den Browser, du gibst den Zugriff bei Digistore24 frei, und das
# Skript holt den Key ab. Nichts davon muss von Hand eingetragen werden:
# DIGISTORE_API_KEY=
#
# Die IPN-Passphrase (SHA512-Prüfung eingehender Events) und eine stabile
# domain_id für die IPN-Anbindung schreibt `make ds24-sync` selbst hierher —
# nicht von Hand setzen:
# DIGISTORE_IPN_PASSPHRASE=
# DIGISTORE_IPN_DOMAIN_ID=
#
# Der Assistent funktioniert ohne weitere Konfiguration — das Template bringt
# einen Developer-Key mit (scripts/ds24/connect-api-key.mjs). Der trägt keine
# Kontorechte und dient nur als Kennung der Anwendung; der echte API-Key
# entsteht erst bei der Freigabe im Browser. Nur setzen, wer einen eigenen
# Developer-Key nutzen will:
# DIGISTORE_DEVELOPER_KEY=
# Angeforderte Berechtigungen des erzeugten Keys (an DS24 anpassen; für
# createBuyUrl schreibenden Zugriff wählen):
# DIGISTORE_REQUESTED_PERMISSIONS=writable
#
# Rückleitungs-Adresse des Assistenten. Digistore24 akzeptiert keine
# localhost-URL, deshalb der Umweg über eine öffentliche Weiterleitungs-Seite.
# Nur ändern, wer eine eigene betreibt:
# DIGISTORE_CONNECT_RELAY=https://digistore24-app-template.com/connect/return
#
# Produkte werden zentral in config/digistore-products.json verwaltet; die
# productIds schreibt scripts/ds24/sync-products.mjs dort hinein (nicht hier).
#
# Für das Produkt-Approval (Go-Live): Siteowner-ID des DS24-Marktplatzes.
# DIGISTORE_SITEOWNER_ID=
